# syntax=docker/dockerfile:1
# T-0041 / SPEC-0045 AC1 / ADR-0065 decision 1: the operator ships as a first-party
# image from scratch, never a shell-bearing base — the same posture as the data-plane
# binary it converges. Its digest is pinned and signed in deploy/releases/ like every
# other first-party release; the install no longer accepts a customer-supplied operator
# image.
FROM docker.io/library/golang:1.27.0-alpine3.23 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' \
    -o /out/operator-app ./cmd/operator-app

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/operator-app /operator-app
USER 65532:65532
CMD ["/operator-app"]
